<Window x:Class="Kutu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kutu · 局域网文件分享" Icon="pack://application:,,,/Assets/Kutu-logo.png" Width="760" Height="680" MinWidth="600" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2463EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E8EEFA" />
            <Setter Property="Foreground" Value="#234275" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,26,30,24">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/Kutu-logo.png" Width="42" Height="42" Margin="0,0,12,0" />
                <TextBlock Text="Kutu" FontSize="30" FontWeight="Bold" Foreground="#17294D" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="文件分享 · 三步把文件夹分享给同一局域网中的朋友" FontSize="15" Foreground="#64748B" Margin="0,5,0,22" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="① 选择要分享的文件夹" FontSize="18" FontWeight="SemiBold" Foreground="#17294D" />
                    <TextBlock Text="朋友可以浏览、下载并上传文件；同名文件不会覆盖。请选一个愿意分享的文件夹。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,7,0,15" />
                    <DockPanel LastChildFill="True">
                        <Button x:Name="ChooseButton" Content="选择文件夹" Click="ChooseFolder_Click" DockPanel.Dock="Right" Margin="12,0,0,0" />
                        <Border Background="#F2F5FA" CornerRadius="8" Padding="14,11">
                            <TextBlock x:Name="FolderText" Text="尚未选择文件夹" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="② 启动分享" FontSize="18" FontWeight="SemiBold" Foreground="#17294D" />
                    <TextBlock Text="分享只在程序运行期间有效。首次启动时，请允许 Windows 防火墙的“专用网络”访问。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,7,0,15" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartButton" Content="开始分享" Click="Start_Click" IsEnabled="False" MinWidth="126" />
                        <Button x:Name="StopButton" Content="停止分享" Click="Stop_Click" IsEnabled="False" Style="{StaticResource SecondaryButton}" MinWidth="126" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="等待选择文件夹" Foreground="#64748B" Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="③ 获取并发送访问地址" FontSize="18" FontWeight="SemiBold" Foreground="#17294D" />
                    <TextBlock Text="每次点击都会重新检测本机地址并复制到剪贴板。然后把地址发给同一 Wi-Fi 或局域网中的朋友。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,7,0,15" />
                    <ComboBox x:Name="AddressPicker" Height="38" VerticalContentAlignment="Center" SelectionChanged="AddressPicker_SelectionChanged" Margin="0,0,0,10" />
                    <DockPanel LastChildFill="True">
                        <Button x:Name="CopyButton" Content="获取并复制访问地址" Click="CopyAddress_Click" IsEnabled="False" DockPanel.Dock="Right" Margin="12,0,0,0" />
                        <Border Background="#F2F5FA" CornerRadius="8" Padding="14,11">
                            <TextBlock x:Name="UrlText" Text="开始分享后显示地址" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </DockPanel>
                    <TextBlock x:Name="CopyStatusText" Foreground="#2463EB" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="仅供可信任的局域网使用。访问者能上传文件；连接公共 Wi-Fi 时，请先停止分享。" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,10" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                <TextBlock x:Name="VersionText" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="12" Margin="12,0,0,0" />
                <Button x:Name="InstallUpdateButton" Content="下载并更新" Click="InstallUpdate_Click" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="12" Margin="8,0,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="UpdateStatusText" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
